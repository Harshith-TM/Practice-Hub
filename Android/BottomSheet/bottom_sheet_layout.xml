<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/imperial"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:fontFamily="@font/montserrat_bold"
        android:text="@string/Bottom_Sheet_Title"
        android:textColor="@color/night"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/TextEntered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:backgroundTint="@color/night"
        android:fontFamily="@font/montserrat_semibold"
        android:hint="@string/Enter_Any_Text"
        android:inputType="text"
        android:textColor="@color/night"
        android:textColorHint="@color/white_50"
        android:textSize="20sp" />

    <Button
        android:id="@+id/EnterTextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:backgroundTint="@color/night"
        android:fontFamily="@font/montserrat_semibold"
        android:text="@string/Enter_Text"
        android:textColor="@color/imperial"
        android:textSize="16sp"
        app:cornerRadius="12dp" />

    <Button
        android:id="@+id/CloseBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:backgroundTint="@color/night"
        android:fontFamily="@font/montserrat_semibold"
        android:text="@string/Close_Bottom_Sheet"
        android:textColor="@color/imperial"
        android:textSize="16sp"
        app:cornerRadius="12dp" />

</LinearLayout>